{
  "name": "copilot-ui",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm --workspace @copilot-ui/server run dev",
    "dev:web": "npm --workspace @copilot-ui/web run dev",
    "doctor": "node scripts/doctor.mjs",
    "build": "npm run build:shared && npm run build:server && npm run build:web",
    "build:shared": "npm --workspace @copilot-ui/shared run build",
    "build:server": "npm --workspace @copilot-ui/server run build",
    "build:web": "npm --workspace @copilot-ui/web run build",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "npm --workspace @copilot-ui/server run seed"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "concurrently": "^9.1.2",
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  }
}
